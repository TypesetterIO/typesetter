{
    "name": "typesetterio/typesetter",
    "description": "The main typesetter service for generating PDFs from Markdown for ebooks.",
    "keywords": ["markdown", "pdf", "ebook", "book", "mpdf", "commonmark"],
    "homepage": "https://typesetter.io",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "league/commonmark": "^2.4",
        "mpdf/mpdf": "^8.1",
        "spatie/commonmark-highlighter": "^3.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Typesetterio\\Typesetter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "php-cs-fixer check --show-progress=none",
        "phpcs-fix": "php-cs-fixer fix --show-progress=none",
        "phpstan": "phpstan",
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-html coverage --path-coverage"
        ],
        "ci": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "phpcs": "Check coding standard with PHP CS Fixer",
        "phpcs-fix": "Fix coding standard with PHP CS Fixer",
        "phpstan": "Run PHPStan",
        "test": "Run the PHPUnit tests",
        "coverage": "Write an HTML coverage report",
        "ci": "Run all CI tests"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
