{
    "name": "typesetterio/typesetter",
    "description": "The main typesetter service for generating PDFs from Markdown for ebooks.",
    "keywords": ["markdown", "pdf", "ebook", "book", "mpdf", "commonmark"],
    "homepage": "https://typesetter.io",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "league/commonmark": "^2.4",
        "mpdf/mpdf": "^8.1",
        "spatie/commonmark-highlighter": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "roave/security-advisories": "dev-latest",
        "slevomat/coding-standard": "^8.12",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Typesetterio\\Typesetter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs -s",
        "phpstan": "phpstan",
        "test": "phpunit",
        "ci": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "phpcs": "Run PHP Code Sniffer",
        "phpstan": "Run PHPStan",
        "test": "Run the PHPUnit tests",
        "ci": "Run all CI tests"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
